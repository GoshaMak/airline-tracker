@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

class aircraft {
   aircraft_model_id: uuid
   registration_number: varchar(10)
   serial_number: varchar(10)
   mileage: integer
   id: uuid
}
class aircraft_models {
   manufacturer: varchar(50)
   model: varchar(50)
   mass: integer
   max_altitude: integer
   max_speed: integer
   id: uuid
}
class airports {
   iata_code: varchar(10)
   title: varchar(128)
   city: varchar(128)
   country: varchar(128)
   id: uuid
}
class flights {
   aircraft_id: uuid
   scheduled_departure: timestamp
   scheduled_arrival: timestamp
   actual_departure: timestamp
   actual_arrival: timestamp
   status: varchar(20)
   plan: varchar(128)
   id: uuid
}
class gates {
   airport_id: uuid
   number: varchar(128)
   id: uuid
}
class subscriptions {
   user_id: uuid
   flight_id: uuid
   id: uuid
}
class users {
   email: varchar(256)
   password: varchar(128)
   role: varchar(20)
   id: uuid
}
class visits {
   flight_id: uuid
   departure_gate_id: uuid
   arrival_gate_id: uuid
   id: uuid
}

aircraft         -[#595959,plain]-^  aircraft_models : "aircraft_model_id:id"
flights          -[#595959,plain]-^  aircraft        : "aircraft_id:id"
gates            -[#595959,plain]-^  airports        : "airport_id:id"
subscriptions    -[#595959,plain]-^  flights         : "flight_id:id"
subscriptions    -[#595959,plain]-^  users           : "user_id:id"
visits           -[#595959,plain]-^  flights         : "flight_id:id"
visits           -[#595959,plain]-^  gates           : "departure_gate_id:id"
visits           -[#595959,plain]-^  gates           : "arrival_gate_id:id"
@enduml
