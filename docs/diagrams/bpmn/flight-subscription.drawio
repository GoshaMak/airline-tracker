<mxfile host="app.diagrams.net" version="28.2.5">
  <diagram id="flight-subscription" name="Подписка на рейс">
    <mxGraphModel dx="1600" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
