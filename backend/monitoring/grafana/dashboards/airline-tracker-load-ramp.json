{
  "uid": "airline-tracker-load",
  "title": "Airline Tracker — Ramp",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "airline-tracker",
    "load",
    "ramp"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Gradual load increase: compare virtual users, throughput, latency and resource usage. Select RUN_ID and set the exact test interval. Expected HTTP 400 operations are separate from unexpected failures. Delivery percentiles cover received emails; check failures alongside them. Resource CPU 100% = one logical CPU. Disk metrics depend on the Docker host.",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_api_requests_total{profile=\"ramp\"}, run_id)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Virtual users",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus{run_id=\"$run_id\",profile=\"ramp\"})",
          "legendFormat": "VU",
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_api_requests_total{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval]))",
          "legendFormat": "API requests",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP latency over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum(rate(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__rate_interval])))",
          "legendFormat": "p75",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.9, sum(rate(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(rate(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "instant": false
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(1.00, sum(rate(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__rate_interval])))",
          "legendFormat": "p100",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP latency (selected interval)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "p50",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "p75",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.9, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "p90",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "p95",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "p99",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(1.00, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "p100",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP latency histogram — request count",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_fraction(0, 0.01, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0–0.01 s",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_fraction(0.01, 0.025, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0.01–0.025 s",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "histogram_fraction(0.025, 0.05, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0.025–0.05 s",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "histogram_fraction(0.05, 0.1, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0.05–0.1 s",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "histogram_fraction(0.1, 0.25, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0.1–0.25 s",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "histogram_fraction(0.25, 0.5, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0.25–0.5 s",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "histogram_fraction(0.5, 1, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "0.5–1 s",
          "instant": true
        },
        {
          "refId": "H",
          "expr": "histogram_fraction(1, 2, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "1–2 s",
          "instant": true
        },
        {
          "refId": "I",
          "expr": "histogram_fraction(2, 5, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "2–5 s",
          "instant": true
        },
        {
          "refId": "J",
          "expr": "histogram_fraction(5, +Inf, sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range]))) * histogram_count(sum(increase(k6_http_req_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\",target=\"api\"}[$__range])))",
          "legendFormat": "5+ s",
          "instant": true
        }
      ],
      "options": {
        "xField": "Field",
        "orientation": "vertical",
        "showValue": "auto"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Unexpected API responses / notification delivery timeouts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_unexpected_response_rate{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"})",
          "legendFormat": "unexpected API",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "1 - avg(k6_notification_delivered_rate{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"})",
          "legendFormat": "notification timeout",
          "instant": false
        }
      ],
      "description": "Notification timeout means the test did not observe the email within MAIL_TIMEOUT_SECONDS (30 seconds by default). It may arrive later."
    },
    {
      "id": 7,
      "title": "Notification latency — PATCH start to Mailpit receipt",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum(rate(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p75",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.9, sum(rate(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(rate(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "instant": false
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(1.00, sum(rate(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p100",
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Notification latency (selected interval)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(increase(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__range])))",
          "legendFormat": "p50",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum(increase(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__range])))",
          "legendFormat": "p75",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.9, sum(increase(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__range])))",
          "legendFormat": "p90",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(increase(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__range])))",
          "legendFormat": "p95",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(increase(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__range])))",
          "legendFormat": "p99",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(1.00, sum(increase(k6_notification_latency_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__range])))",
          "legendFormat": "p100",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Worker shared queues",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (airline_tracker_queue_pending)",
          "legendFormat": "{{queue}}",
          "instant": false
        }
      ],
      "description": "Email queue includes future scheduled notifications. Compare backlog with its baseline; it need not return to zero."
    },
    {
      "id": 10,
      "title": "Oldest pending job",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (airline_tracker_queue_oldest_seconds)",
          "legendFormat": "{{queue}}",
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Worker operations / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, result) (rate(airline_tracker_jobs_total[$__rate_interval]))",
          "legendFormat": "{{instance}} {{result}}",
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic=~\"subscription-created|flight-updated\"})",
          "legendFormat": "{{consumergroup}} {{topic}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "CPU usage (100% equals one logical CPU)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"airline-test-$run_id\",container_label_com_docker_compose_service=~\"api|notifier|publisher|redis\"}[30s])) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "instant": false
        }
      ],
      "interval": "5s",
      "maxDataPoints": 10000
    },
    {
      "id": 14,
      "title": "RAM usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"airline-test-$run_id\",container_label_com_docker_compose_service=~\"api|notifier|publisher|redis\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "instant": false
        }
      ],
      "interval": "5s",
      "maxDataPoints": 10000
    },
    {
      "id": 15,
      "title": "CPU usage (100% equals one logical CPU) — selected interval summary",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"airline-test-$run_id\",container_label_com_docker_compose_service=~\"api|notifier|publisher|redis\"}[30s])) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "instant": false
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "min",
              "max",
              "mean",
              "median"
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "interval": "5s",
      "maxDataPoints": 10000
    },
    {
      "id": 16,
      "title": "RAM usage — selected interval summary",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
