    {
      "id": 21,
      "title": "API PostgreSQL pool connections",
      "type": "timeseries",
      "description": "API-side pgx pool snapshot by instance. Acquired connections are checked out by requests; idle connections are available. Metrics follow the selected time interval; application metrics do not carry RUN_ID.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airline_tracker_postgres_pool_connections{job=\"application\",service=~\"api|api-read-.*|api-mirror.*\",state=~\"total|acquired|idle|constructing\"}",
          "legendFormat": "{{instance}} — {{state}}",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "airline_tracker_postgres_pool_max_connections{job=\"application\",service=~\"api|api-read-.*|api-mirror.*\"}",
          "legendFormat": "{{instance}} — pool limit",
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "title": "PostgreSQL server connections",
      "type": "timeseries",
      "description": "Server-side connections across all databases and clients on the primary, including monitoring connections. Shows total connections, session states, sessions waiting for locks, maximum server connections and the connection limit available to ordinary roles. Active includes queries waiting for resources. Waiting for lock is a subset of active and must not be added to the total. Server metrics do not carry RUN_ID.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* — max connections"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* — usable limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    5,
                    5
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* — total connections"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* — idle in transaction"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* — waiting for lock"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (pg_stat_database_numbackends{job=\"postgres\"})",
          "legendFormat": "{{instance}} — total connections",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "pg_settings_max_connections{job=\"postgres\"}",
          "legendFormat": "{{instance}} — max connections",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "pg_settings_max_connections{job=\"postgres\"} - pg_settings_superuser_reserved_connections{job=\"postgres\"} - (pg_settings_reserved_connections{job=\"postgres\"} or (pg_settings_max_connections{job=\"postgres\"} * 0))",
          "legendFormat": "{{instance}} — usable limit",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "sum by (instance) (pg_stat_activity_count{job=\"postgres\",state=\"active\"})",
          "legendFormat": "{{instance}} — active",
          "instant": false
        },
        {
          "refId": "E",
          "expr": "sum by (instance) (pg_stat_activity_count{job=\"postgres\",state=\"idle\"})",
          "legendFormat": "{{instance}} — idle",
          "instant": false
        },
        {
          "refId": "F",
          "expr": "sum by (instance) (pg_stat_activity_count{job=\"postgres\",state=\"idle in transaction\"})",
          "legendFormat": "{{instance}} — idle in transaction",
          "instant": false
        },
        {
          "refId": "G",
          "expr": "sum by (instance) (pg_stat_activity_count{job=\"postgres\",state=\"idle in transaction (aborted)\"})",
          "legendFormat": "{{instance}} — aborted transaction",
          "instant": false
        },
        {
          "refId": "H",
          "expr": "sum by (instance) (pg_stat_activity_count{job=\"postgres\",state=\"active\",wait_event_type=\"Lock\"})",
          "legendFormat": "{{instance}} — waiting for lock",
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 23,
      "title": "Complete journey duration over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(k6_journey_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum(rate(k6_journey_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p75",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.9, sum(rate(k6_journey_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(k6_journey_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(rate(k6_journey_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "instant": false
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(1.00, sum(rate(k6_journey_duration_seconds{run_id=\"$run_id\",profile=\"ramp\",scenario=\"users\"}[$__rate_interval])))",
          "legendFormat": "p100",
          "instant": false
        }
      ],
      "description": "Elapsed time for one full load-test journey, including API calls, configured think time, and waiting for notification delivery."
    },
