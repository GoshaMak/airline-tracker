{
  "uid": "airline-tracker",
  "title": "Airline Tracker",
  "tags": [
    "airline-tracker",
    "main"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"application|nginx\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}, service)",
          "refId": "service"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"application|nginx\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "NGINX status",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_up{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "API rps",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(airline_tracker_http_requests_total{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "API latency",
      "description": "Средняя задержка и p95/p99/p100 по каждому сервису за скользящее окно $__rate_interval. Ось Y — миллисекунды. Перцентили оцениваются по бакетам гистограммы; p100 — оценка максимума, а не точный максимум. Значения выше последнего конечного бакета ограничены его верхней границей.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum by (service) (rate(airline_tracker_http_request_duration_seconds_sum{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval])) / sum by (service) (rate(airline_tracker_http_request_duration_seconds_count{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval]))",
          "legendFormat": "{{service}} mean"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, service) (rate(airline_tracker_http_request_duration_seconds_bucket{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval])))",
          "legendFormat": "{{service}} p95"
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le, service) (rate(airline_tracker_http_request_duration_seconds_bucket{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval])))",
          "legendFormat": "{{service}} p99"
        },
        {
          "refId": "D",
          "expr": "1000 * histogram_quantile(1, sum by (le, service) (rate(airline_tracker_http_request_duration_seconds_bucket{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval])))",
          "legendFormat": "{{service}} p100 (estimate)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 5,
      "title": "API requests by status / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, status) (rate(airline_tracker_http_requests_total{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "NGINX rps",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total{service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}[$__rate_interval])",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Process resident memory",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Application logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"airline_tracker\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-publisher|notifier|nginx|frontend\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
