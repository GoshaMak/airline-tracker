{
  "uid": "airline-tracker-endpoints",
  "title": "Airline Tracker — Endpoints",
  "description": "Статистика API по HTTP-методу и шаблону маршрута, суммарно по выбранным экземплярам. Записи из mirror обрабатываются общим api; выбор сервиса разделяет экземпляры, а не исходный URL запроса.",
  "tags": [
    "airline-tracker",
    "endpoints"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"application\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\"}, service)",
          "refId": "service"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\"}, method)",
          "refId": "method"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",method=~\"$method\"}, route)",
          "refId": "route"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per endpoint",
      "description": "Оценка числа запросов за выбранный диапазон времени через increase; учитывает сбросы счётчиков. Не является точным журналом каждого запроса.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (increase(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Requests"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "RPS per endpoint",
      "description": "Частота запросов по методу и шаблону маршрута, суммарно по выбранным экземплярам.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 3,
      "title": "Latency per endpoint",
      "description": "Средняя задержка и p95/p99/p100 по методу и маршруту за скользящее окно $__rate_interval. Перцентили — оценки по бакетам, p100 не является точным максимумом; значения в +Inf ограничены границей последнего конечного бакета. Выберите одну ручку, чтобы уменьшить число линий.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum by (method, route) (rate(airline_tracker_http_request_duration_seconds_sum{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval])) / sum by (method, route) (rate(airline_tracker_http_request_duration_seconds_count{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} mean"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, method, route) (rate(airline_tracker_http_request_duration_seconds_bucket{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}} p95"
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le, method, route) (rate(airline_tracker_http_request_duration_seconds_bucket{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}} p99"
        },
        {
          "refId": "D",
          "expr": "1000 * histogram_quantile(1, sum by (le, method, route) (rate(airline_tracker_http_request_duration_seconds_bucket{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}} p100 (estimate)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 4,
      "title": "Response statuses per endpoint",
      "description": "RPS с разбивкой по HTTP-статусу, методу и маршруту.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route, status) (rate(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} → {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 5,
      "title": "5xx responses per endpoint",
      "description": "Доля ответов 5xx в процентах по каждому endpoint. Без запросов значение не определено; отсутствие серии 5xx при наличии трафика отображается как 0%.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (method, route) (rate(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum by (method, route) (rate(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval]))))) / (sum by (method, route) (rate(airline_tracker_http_requests_total{job=\"application\",service=~\"$service\",service=~\"api|api-read-1|api-read-2|api-mirror|api-mirror-read-1|api-mirror-read-2\",method=~\"$method\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    }
  ]
}
